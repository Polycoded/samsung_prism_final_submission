# Copy to prototype/.env for Docker Compose. No secrets are needed.
CITEFRONTIER_PORT=8000
CITEFRONTIER_DEMO=0
# Set CITEFRONTIER_DEMO=1 only for the optional authored live-presentation fixtures.

# Docker defaults to guarded local BERT with spaCy fallback. These values are
# already declared in docker-compose.yml and are shown here for local launches.
# The Python runtime does not automatically load this file.
# CITEFRONTIER_BACKEND=dense
# CITEFRONTIER_PARSER=auto
# CITEFRONTIER_FALLBACK_PARSER=spacy
# CITEFRONTIER_BERT_MODEL=../bert_intent_tagger/model/checkpoints/best
# CITEFRONTIER_BERT_THRESHOLD=0.90
# CITEFRONTIER_BERT_DISAGREE_THRESHOLD=0.97
# CITEFRONTIER_CORPUS=J:/path/to/ingested-corpus.json
# Docker provisions pinned dense models at build time; local Python runs use
# `python -m prototype.prepare_models` once before offline inference.
